{
  "name": "algo_trader-trading-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:parity": "npx tsx server/trading/testing/test_all_parity.ts",
    "test:parity:quick": "npx tsx server/trading/testing/test_all_parity.ts",
    "test:parity:6mo": "npx tsx server/trading/testing/parity/run_last_6mo.ts",
    "backtest:modes": "npx tsx server/trading/testing/simulate_risk_modes.ts",
    "optimize:all": "npx tsx server/trading/optimizer/pipelines/master_pipeline.ts",
    "test:pipeline:robust": "npx tsx server/trading/testing/test_pipeline_robustness.ts"
  },
  "dependencies": {
    "@google/genai": "^2.7.0",
    "@google/generative-ai": "^0.24.1",
    "@react-oauth/google": "^0.13.5",
    "@sinonjs/fake-timers": "^15.4.0",
    "bcrypt": "^5.1.1",
    "canvas": "^3.2.3",
    "cookie-parser": "^1.4.7",
    "csv-parser": "^3.2.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "forexfactory-scraper": "^1.0.14",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.2",
    "metaapi.cloud-sdk": "^29.3.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.8",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0",
    "puppeteer-core": "^25.3.0",
    "sinon": "^22.0.0",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yahoo-finance2": "^3.14.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/sinon": "^21.0.1",
    "@types/sinonjs__fake-timers": "^15.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jest": "^30.4.2",
    "lightweight-charts": "^4.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^6.22.3",
    "recharts": "^3.8.1",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.1.14",
    "ts-jest": "^29.4.11",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
